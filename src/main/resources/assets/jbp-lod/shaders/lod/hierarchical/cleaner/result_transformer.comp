layout(local_size_x = OUTPUT_SIZE) in;
layout(set = 0, binding = MIN_ID_BUFFER_BINDING, std430) restrict readonly buffer VisibilityDataBuffer {
    uint minVisIds[OUTPUT_SIZE];
};
layout(set = 0, binding = NODE_BUFFER_BINDING, std430) restrict readonly buffer NodeData {
    uvec4 nodes[];
};
layout(set = 0, binding = OUTPUT_BUFFER_BINDING, std430) restrict writeonly buffer OutputBuffer {
    uvec2 outputBuffer[OUTPUT_SIZE];
};
layout(set = 0, binding = VISIBILITY_BUFFER_BINDING, std430) restrict buffer VisibilityBuffer {
    uint visibility[];
};
layout(push_constant) uniform ResultTransformPushConstants {
    uint visibilityCounter;
};

void main() {
    uint id = minVisIds[gl_LocalInvocationID.x];
    uvec4 node = nodes[id];
