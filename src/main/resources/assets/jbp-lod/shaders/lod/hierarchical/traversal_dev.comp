    if (!(outsideFrustum() || isCulledByHiz())) {
        if (node.lodLevel != 0 && shouldDecend()) {
            if (hasChildren(node)) {
                enqueueChildren(node);
            } else {
                addRequest(node);
                bool shouldRenderSelf = renderDistance < 0.0;
                if (!shouldRenderSelf) {
                    vec3 farPoint = furthestPointToCamera(node);
                    shouldRenderSelf = (farPoint.x * farPoint.x + farPoint.z * farPoint.z + (16 * 16 * 16)) <= renderDistance;
                }
                if (shouldRenderSelf) enqueueSelfForRender(node);
