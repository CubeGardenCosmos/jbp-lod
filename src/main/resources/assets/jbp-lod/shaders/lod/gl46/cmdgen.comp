// Derived from MCRcortex/voxy 263: assets/voxy/shaders/lod/gl46/cmdgen.comp
layout(local_size_x=128) in;

#define DRAW_BUFFER_BINDING 1
#define DRAW_COUNT_BUFFER_BINDING 2
#define SECTION_METADATA_BUFFER_BINDING 3
#define VISIBILITY_BUFFER_BINDING 4
#define INDIRECT_SECTION_LOOKUP_BINDING 5
#define POSITION_SCRATCH_BINDING 6
#define POSITION_SCRATCH_ACCESS writeonly

#import <jbp-lod:lod/section.glsl>
#import <jbp-lod:lod/gl46/bindings.glsl>

#ifdef HAS_STATISTICS
layout(set=0, binding=STATISTICS_BUFFER_BINDING, std430) restrict buffer StatisticsBuffer {
    uint visibleSectionCounts[5];
    uint quadCounts[5];
};
#endif

layout(set=0, binding=TRANSLUCENT_DISTANCE_BUFFER_BINDING, std430) restrict buffer TranslucentCommandCount {
    uint translucentCommandData[];
};

// JBP-LOD deviation from upstream: command writes are bounded by their region capacity
// (V3 contract); an overflowing draw is dropped and the control-record count exceeds capacity.
void writeCmd(uint idx, uint limit, uint instance, uint offset, uint quadCount) {
    if (idx >= limit) {
        return;
    }
    DrawCommand cmd;
    cmd.count = quadCount * 6u;
    cmd.instanceCount = 1u;
    cmd.firstIndex = 0u;
    cmd.baseVertex = int(offset)<<2;
    cmd.baseInstance = instance;
    cmdBuffer[idx] = cmd;
}

#define WRITE_OPAQUE(idx, instance, offset, quadCount) writeCmd(idx, uint(OPAQUE_CAPACITY), instance, offset, quadCount)
#define WRITE_TEMPORAL(idx, instance, offset, quadCount) writeCmd(idx, uint(TEMPORAL_OFFSET)+uint(TEMPORAL_CAPACITY), instance, offset, quadCount)

// JBP-LOD deviation from upstream: no draw command for a section whose whole horizontal AABB is nearer
// than the near-exclusion radius. The radius is the vanilla coverage radius (renderDistanceChunks * 16,
// clamped by active environmental fog) MINUS the inward overlap margin, so the excluded disk can never
// reach past the region Sodium guarantees to draw. Excluding with a larger radius left an annulus that
// neither vanilla (culled) nor LOD (excluded) drew: a circular hole ring at the vanilla edge. Uses the
// AABB's farthest horizontal point so a section straddling the radius is still drawn (overlap) and no
// seam opens. The radius is refreshed every frame from the live game options, so it follows teleports and
// render-distance changes.
bool isExcludedByNearRange(SectionMeta meta, uint detail) {
    if (exclusionRadius <= 0.0) {
        return false;
    }
    ivec3 ipos = extractPosition(meta);
    vec3 relative32 = vec3((ipos * int(1u << detail)) - baseSectionPos);
    float size = float(32u << detail);
    vec2 minCorner = vec2(relative32.x, relative32.z) * 32.0;
    vec2 maxCorner = minCorner + vec2(size);
    vec2 camera = cameraSubPos.xz;
    vec2 farDistance = max(abs(camera - minCorner), abs(camera - maxCorner));
    return dot(farDistance, farDistance) < exclusionRadius * exclusionRadius;
}

void main() {
    if (gl_GlobalInvocationID.x >= sectionCount) {
        return;
    }
    uint sectionId = indirectLookup[gl_GlobalInvocationID.x];
    SectionMeta meta = sectionData[sectionId];
    uint detail = extractDetail(meta);
    if (isExcludedByNearRange(meta, detail)) {
        return;
    }
    ivec3 ipos = extractPosition(meta);

    uint dat = visibilityData[sectionId];

    //if the section was visible this frame
    bool shouldRender = (dat&0x7fffffffu) == frameId;
    bool renderTemporally = (dat&0x80000000u)==0;// means, if it was not visible last frame

    if (shouldRender) {

        #ifdef HAS_STATISTICS
        atomicAdd(visibleSectionCounts[detail], 1u);
        #endif

        uint ptr = extractQuadStart(meta);
        ivec3 relative = ipos-(baseSectionPos>>detail);
        uint drawId = gl_GlobalInvocationID.x;

        positionBuffer[drawId] = extractRawPos(meta);
        uvec4 counts = meta.b;

        //TODO implicit command merging
        uint msk = 0;
        msk |= uint(((counts.y      &0xFFFFu)!=0) && (relative.y>-1))<<0;
        msk |= uint((((counts.y>>16)&0xFFFFu)!=0) && (relative.y<1 ))<<1;
        msk |= uint(((counts.z      &0xFFFFu)!=0) && (relative.z>-1))<<2;
        msk |= uint((((counts.z>>16)&0xFFFFu)!=0) && (relative.z<1 ))<<3;
        msk |= uint(((counts.w      &0xFFFFu)!=0) && (relative.x>-1))<<4;
        msk |= uint((((counts.w>>16)&0xFFFFu)!=0) && (relative.x<1 ))<<5;

        msk |= uint(((counts.x>>16)&0xFFFFu)!=0)<<6;

        uint cmdCnt = bitCount(msk);
        uint cmdPtr = atomicAdd(opaqueDrawCount, cmdCnt);

        uint tCmdPtr = 0u;
        if (renderTemporally) {
            tCmdPtr = atomicAdd(temporalOpaqueDrawCount, cmdCnt) + uint(TEMPORAL_OFFSET);
        }

        #ifdef HAS_STATISTICS
        uint totalQuads = 0u;
        #endif

        uint count = 0u;
        //Translucency
        count = counts.x&0xFFFFu;
        if (count != 0) {
            uint tp = atomicAdd(translucentDrawCount, 1u)+uint(TRANSLUCENT_WRITE_BASE);
            if (tp < uint(TRANSLUCENT_WRITE_BASE)+uint(TRANSLUCENT_CAPACITY)) {
                translucentCommandData[tp] = drawId;
                uvec3 absRel = uvec3(abs(relative));
                uint distToCamera = (absRel.x+absRel.y+absRel.z)<<detail;
                //The -1 is because we want 0 to TRANSLUCENT_WRITE_BASE, exclusive of ending, not inclusive (0->1023)
                distToCamera = uint(TRANSLUCENT_WRITE_BASE-1)-min(distToCamera, uint(TRANSLUCENT_WRITE_BASE-1));
                atomicAdd(translucentCommandData[distToCamera], 1u);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        //Double sided quads
        count = (counts.x>>16)&0xFFFFu;
        if (count != 0) {
            WRITE_OPAQUE(cmdPtr++, drawId, ptr, count);
            if (renderTemporally) {
                WRITE_TEMPORAL(tCmdPtr++, drawId, ptr, count);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        //Down
        count = (counts.y)&0xFFFFu;
        if (((msk&(1u<<0))!=0)) {
            WRITE_OPAQUE(cmdPtr++, drawId, ptr, count);
            if (renderTemporally) {
                WRITE_TEMPORAL(tCmdPtr++, drawId, ptr, count);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        //Up
        count = (counts.y>>16)&0xFFFFu;
        if ((msk&(1u<<1))!=0) {
            WRITE_OPAQUE(cmdPtr++, drawId, ptr, count);
            if (renderTemporally) {
                WRITE_TEMPORAL(tCmdPtr++, drawId, ptr, count);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        //North
        count = (counts.z)&0xFFFFu;
        if ((msk&(1u<<2))!=0) {
            WRITE_OPAQUE(cmdPtr++, drawId, ptr, count);
            if (renderTemporally) {
                WRITE_TEMPORAL(tCmdPtr++, drawId, ptr, count);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        //South
        count = (counts.z>>16)&0xFFFFu;
        if ((msk&(1u<<3))!=0) {
            WRITE_OPAQUE(cmdPtr++, drawId, ptr, count);
            if (renderTemporally) {
                WRITE_TEMPORAL(tCmdPtr++, drawId, ptr, count);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        //West
        count = (counts.w)&0xFFFFu;
        if ((msk&(1u<<4))!=0) {
            WRITE_OPAQUE(cmdPtr++, drawId, ptr, count);
            if (renderTemporally) {
                WRITE_TEMPORAL(tCmdPtr++, drawId, ptr, count);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        //East
        count = (counts.w>>16)&0xFFFFu;
        if ((msk&(1u<<5))!=0) {
            WRITE_OPAQUE(cmdPtr++, drawId, ptr, count);
            if (renderTemporally) {
                WRITE_TEMPORAL(tCmdPtr++, drawId, ptr, count);
            }
            #ifdef HAS_STATISTICS
            totalQuads += count;
            #endif
        }
        ptr += count;

        #ifdef HAS_STATISTICS
        atomicAdd(quadCounts[detail], totalQuads);
        #endif
    }
}
