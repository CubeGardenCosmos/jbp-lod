// Derived from MCRcortex/voxy 263: assets/voxy/shaders/hiz/hiz.comp
#ifdef USE_SUBGROUP
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#endif

// One workgroup reduces each 64x64 source region into mip levels 1 through 6.
layout(local_size_x = 256) in;

const uint spread[64] = {
    0x11100100, 0x13120302, 0x31302120, 0x33322322, 0x15140504, 0x17160706, 0x35342524, 0x37362726,
    0x51504140, 0x53524342, 0x71706160, 0x73726362, 0x55544544, 0x57564746, 0x75746564, 0x77766766,
    0x19180908, 0x1b1a0b0a, 0x39382928, 0x3b3a2b2a, 0x1d1c0d0c, 0x1f1e0f0e, 0x3d3c2d2c, 0x3f3e2f2e,
    0x59584948, 0x5b5a4b4a, 0x79786968, 0x7b7a6b6a, 0x5d5c4d4c, 0x5f5e4f4e, 0x7d7c6d6c, 0x7f7e6f6e,
    0x91908180, 0x93928382, 0xb1b0a1a0, 0xb3b2a3a2, 0x95948584, 0x97968786, 0xb5b4a5a4, 0xb7b6a7a6,
    0xd1d0c1c0, 0xd3d2c3c2, 0xf1f0e1e0, 0xf3f2e3e2, 0xd5d4c5c4, 0xd7d6c7c6, 0xf5f4e5e4, 0xf7f6e7e6,
    0x99988988, 0x9b9a8b8a, 0xb9b8a9a8, 0xbbbaabaa, 0x9d9c8d8c, 0x9f9e8f8e, 0xbdbcadac, 0xbfbeafae,
    0xd9d8c9c8, 0xdbdacbca, 0xf9f8e9e8, 0xfbfaebea, 0xdddccdcc, 0xdfdecfce, 0xfdfcedec, 0xfffeefee
};

uint swizzleId(uint id) {
    return bitfieldExtract(spread[id >> 2u], int(id & 3u) * 8, 8);
}

layout(push_constant) uniform HizParams {
    vec2 invImSize;
} pc;

layout(set = 0, binding = 0) uniform sampler2D mip_0;
layout(set = 0, binding = 1, r32f) uniform restrict writeonly image2D mip_1;
layout(set = 0, binding = 2, r32f) uniform restrict writeonly image2D mip_2;
layout(set = 0, binding = 3, r32f) uniform restrict writeonly image2D mip_3;
layout(set = 0, binding = 4, r32f) uniform restrict writeonly image2D mip_4;
layout(set = 0, binding = 5, r32f) uniform restrict writeonly image2D mip_5;
layout(set = 0, binding = 6, r32f) uniform restrict writeonly image2D mip_6;

#ifdef USE_REVERSE_Z
#define REDUCE_DEPTH(a, b) min((a), (b))
#define SUBGROUP_CLUSTERED_REDUCE(value, size) subgroupClusteredMin((value), (size))
#define SUBGROUP_REDUCE(value) subgroupMin(value)
#else
#define REDUCE_DEPTH(a, b) max((a), (b))
#define SUBGROUP_CLUSTERED_REDUCE(value, size) subgroupClusteredMax((value), (size))
#define SUBGROUP_REDUCE(value) subgroupMax(value)
#endif

float getReduce2x2(ivec2 pos) {
    vec4 data = textureGather(mip_0, vec2(pos * 2 + 1) * pc.invImSize);
    float reduced = REDUCE_DEPTH(REDUCE_DEPTH(data.x, data.y), REDUCE_DEPTH(data.z, data.w));
    imageStore(mip_1, pos, vec4(reduced));
    return reduced;
}

float getReduce4x4(ivec2 pos) {
    ivec2 pos2 = pos * 2;
    float reduced = REDUCE_DEPTH(
            REDUCE_DEPTH(getReduce2x2(pos2 + ivec2(0, 0)), getReduce2x2(pos2 + ivec2(0, 1))),
            REDUCE_DEPTH(getReduce2x2(pos2 + ivec2(1, 0)), getReduce2x2(pos2 + ivec2(1, 1))));
    imageStore(mip_2, pos, vec4(reduced));
    return reduced;
}

#ifdef USE_SUBGROUP
// The upstream fast path relies on 4/16-lane clustered reductions in the Z-order mapping.
float getReduceWave(ivec2 pos, float value) {
    float reduced;
    subgroupBarrier();
    reduced = SUBGROUP_CLUSTERED_REDUCE(value, 4);
    if ((gl_SubgroupInvocationID & 3u) == 0u) {
        imageStore(mip_3, pos >> 1, vec4(reduced));
    }
    subgroupBarrier();
    reduced = SUBGROUP_CLUSTERED_REDUCE(value, 16);
    if ((gl_SubgroupInvocationID & 15u) == 0u) {
        imageStore(mip_4, pos >> 2, vec4(reduced));
    }
    return reduced;
}
shared float values[16];
#else
// Shared-memory reduction preserves the same mip values when clustered subgroup ops are absent.
shared float valuesA[256];
shared float valuesB[256];
#endif

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint id = swizzleId(lane);
    ivec2 wavePos = ivec2(gl_WorkGroupID.xy) * 16 + ivec2(id & 15u, id >> 4u);
    float value = getReduce4x4(wavePos);

#ifdef USE_SUBGROUP
    value = getReduceWave(wavePos, value);
    if ((lane & 15u) == 0u) {
        values[lane >> 4u] = value;
    }
    barrier();
    if ((lane >> 2u) != 0u) {
        return;
    }
    uint valueIndex = lane * 4u;
    value = REDUCE_DEPTH(REDUCE_DEPTH(values[valueIndex], values[valueIndex + 1u]),
            REDUCE_DEPTH(values[valueIndex + 2u], values[valueIndex + 3u]));
    imageStore(mip_5, ivec2(gl_WorkGroupID.xy) * 2 + ivec2(lane & 1u, lane >> 1u), vec4(value));
    subgroupBarrier();
    value = SUBGROUP_REDUCE(value);
    if (lane == 0u) {
        imageStore(mip_6, ivec2(gl_WorkGroupID.xy), vec4(value));
    }
#else
    valuesA[id] = value;
    barrier();

    if (lane < 64u) {
        uint x = lane & 7u;
        uint y = lane >> 3u;
        uint sourceX = x * 2u;
        uint sourceY = y * 2u;
        uint sourceIndex = sourceY * 16u + sourceX;
        value = REDUCE_DEPTH(REDUCE_DEPTH(valuesA[sourceIndex], valuesA[sourceIndex + 1u]),
                REDUCE_DEPTH(valuesA[sourceIndex + 16u], valuesA[sourceIndex + 17u]));
        valuesB[lane] = value;
        imageStore(mip_3, ivec2(gl_WorkGroupID.xy) * 8 + ivec2(x, y), vec4(value));
    }
    barrier();

    if (lane < 16u) {
        uint x = lane & 3u;
        uint y = lane >> 2u;
        uint sourceX = x * 2u;
        uint sourceY = y * 2u;
        uint sourceIndex = sourceY * 8u + sourceX;
        value = REDUCE_DEPTH(REDUCE_DEPTH(valuesB[sourceIndex], valuesB[sourceIndex + 1u]),
                REDUCE_DEPTH(valuesB[sourceIndex + 8u], valuesB[sourceIndex + 9u]));
        valuesA[lane] = value;
        imageStore(mip_4, ivec2(gl_WorkGroupID.xy) * 4 + ivec2(x, y), vec4(value));
    }
    barrier();

    if (lane < 4u) {
        uint x = lane & 1u;
        uint y = lane >> 1u;
        uint sourceX = x * 2u;
        uint sourceY = y * 2u;
        uint sourceIndex = sourceY * 4u + sourceX;
        value = REDUCE_DEPTH(REDUCE_DEPTH(valuesA[sourceIndex], valuesA[sourceIndex + 1u]),
                REDUCE_DEPTH(valuesA[sourceIndex + 4u], valuesA[sourceIndex + 5u]));
        valuesB[lane] = value;
        imageStore(mip_5, ivec2(gl_WorkGroupID.xy) * 2 + ivec2(x, y), vec4(value));
    }
    barrier();

    if (lane == 0u) {
        value = REDUCE_DEPTH(REDUCE_DEPTH(valuesB[0], valuesB[1]), REDUCE_DEPTH(valuesB[2], valuesB[3]));
        imageStore(mip_6, ivec2(gl_WorkGroupID.xy), vec4(value));
    }
#endif
}
